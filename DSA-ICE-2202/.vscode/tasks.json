{
  "tasks": [
    {
      "type": "cppbuild",
      "label": "C++ Fast Build",
      "command": "C:\\Office\\ucrt64\\bin\\g++.exe",
      "args": [
        "-std=c++17",
        "-O2",
        "-Wall",
        "${file}",
        "-o",
        "${fileDirname}\\${fileBasenameNoExtension}.exe"
      ],
      "options": {
        "cwd": "${fileDirname}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "detail": "Optimized fast build task"
    }
  ],
  "version": "2.0.0"
}
